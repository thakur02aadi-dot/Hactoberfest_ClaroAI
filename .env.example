# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Gemma Inference Endpoint (Optional for live hosted Gemma inference via Hugging Face or custom endpoint)
# e.g., https://api-inference.huggingface.co/models/google/gemma-2-9b-it
HF_TOKEN=""
GEMMA_ENDPOINT_URL=""
GEMMA_MODEL_ID="google/gemma-2-9b-it"
